---
import { getCollection, render } from "astro:content";
import { contentGraph } from "../../lib/content-graph.js";
import PieceLayout from "../../layouts/PieceLayout.astro";
export async function getStaticPaths() {
  const entries = await getCollection("pieces");
  const graph = contentGraph(entries);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, graph } }));
}
const { entry, graph } = Astro.props;
const piece = graph.pieces.find((piece) => piece.id === entry.id);
const { Content } = await render(entry);
---
<PieceLayout piece={piece} graph={graph}><Content /></PieceLayout>
